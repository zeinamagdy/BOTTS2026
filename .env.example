# Local Postgres from docker-compose. For deploys, use a Neon / Supabase / Vercel Postgres URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/berlin_housing

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional, defaults to gpt-5.5
# OPENAI_MODEL=gpt-5.4-mini

# Optional: where `npm run data:fetch` clones the data repo (default data/tech-battle)
# DATA_DIR=data/tech-battle
